#!/usr/bin/env bash
# crew: set up and check a claude-ai-crew installation.
#   crew init   [--plan] --project NAME --plan-repo ORG/NAME --code-repo ORG/NAME [--code-repo ...]
#               [--runner actions|routines] [--identity single|roles|token] [--no-claude-login] [--harness-repo ORG/NAME] [--harness-ref REF]
#   crew apps create [--crew path/to/crew.json] [--single | --role R ...] [--org] [--plan]   GitHub App(s) via the manifest flow
#   crew activate [--crew path/to/crew.json] [--yes]   merge the install PRs, enable the schedules, run doctor
#   crew apps list   [--crew path/to/crew.json]                                    which roles have an App key and id stored
#   crew doctor [path/to/crew.json]
# `init --plan` prints every action and changes nothing. No secret is ever pasted: the Claude token is fetched by
# `claude setup-token` and the GitHub App key by the manifest flow; both are piped straight into `gh secret set`
# and are never printed, logged or written to disk.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"; HARNESS="$(cd "$HERE/.." && pwd)"
DRY=0; PROJECT=""; PLAN=""; CODES=(); RUNNER=actions; IDENT=single; CLAUDE_LOGIN=1
HREPO="locksmith-hq/claude-ai-crew"; HREF=main
say() { printf '%s\n' "$*"; }
die() { echo "crew: $*" >&2; exit 2; }
# act "<description>" cmd...: prints in --plan mode, otherwise runs and reports failure
act() { local d="$1"; shift; if [ "$DRY" = 1 ]; then say "PLAN   $d"; else say "DO     $d"; "$@" || { say "FAIL   $d"; FAILED=1; }; fi; }
FAILED=0
LABELS="needs-rescue needs-owner needs-research needs-work debate harness-backlog in-progress review-passed review-failed"

cmd_init() {
  while [ $# -gt 0 ]; do case "$1" in
    --plan) DRY=1 ;; --project) PROJECT="$2"; shift ;; --plan-repo) PLAN="$2"; shift ;;
    --code-repo) CODES+=("$2"); shift ;; --runner) RUNNER="$2"; shift ;; --identity) IDENT="$2"; shift ;; --no-claude-login) CLAUDE_LOGIN=0 ;;
    --harness-repo) HREPO="$2"; shift ;; --harness-ref) HREF="$2"; shift ;; *) die "unknown option: $1" ;; esac; shift; done
  [ -n "$PROJECT" ] && [ -n "$PLAN" ] && [ "${#CODES[@]}" -gt 0 ] || die "init needs --project, --plan-repo and at least one --code-repo"
  case "$RUNNER" in actions|routines) ;; *) die "--runner must be actions or routines" ;; esac
  case "$IDENT" in single|roles|token) ;; *) die "--identity must be single, roles or token" ;; esac
  for r in "$PLAN" "${CODES[@]}"; do [[ "$r" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "not an owner/name repo: $r"; done
  command -v gh >/dev/null && command -v jq >/dev/null && command -v git >/dev/null || die "gh, jq and git are required"
  if [ "$DRY" = 1 ]; then owner="<your-login>"; else owner=$(gh api user --jq .login) || die "gh is not logged in"; fi
  work="${CREW_WORK_DIR:-$(mktemp -d)}"
  say "crew init: project=$PROJECT plan=$PLAN code=${CODES[*]} runner=$RUNNER identity=$IDENT owner=$owner"

  # 1. the plan repo
  if [ "$DRY" = 1 ] || ! gh repo view "$PLAN" >/dev/null 2>&1; then act "create private repo $PLAN" gh repo create "$PLAN" --private --add-readme; fi
  # 2. domain pack and starter files, committed to the plan repo's default branch
  pack="$work/crew.json"
  codes_json=$(printf '%s\n' "${CODES[@]}" | jq -R . | jq -s .)
  jq --arg p "$PROJECT" --arg o "$owner" --arg plan "$PLAN" --arg h "$HREPO" --argjson c "$codes_json" \
    '.project=$p | .owner.login=$o | .repos={harness:$h,plan:$plan,code:$c}' "$HARNESS/examples/domain-pack/crew.json" > "$pack" 2>/dev/null || true
  [ "$DRY" = 1 ] && say "PLAN   write crew.json, owner.md, lessons.md, decisions.md, roadmap.md to $PLAN (skipped if present)" || {
    bash "$HERE/validate-pack.sh" "$pack" >/dev/null || die "generated crew.json is invalid"
    act "clone $PLAN and add the domain pack" bash -c "
      git clone -q 'https://github.com/$PLAN.git' '$work/plan' && cd '$work/plan' &&
      { [ -e crew.json ] || cp '$pack' crew.json; } && for f in owner lessons decisions roadmap; do [ -e \$f.md ] || cp '$HARNESS/templates/starter/'\$f.md \$f.md; done &&
      git add -A && { git diff --cached --quiet || { git commit -q -m 'Add the claude-ai-crew domain pack' && git push -q; }; }"; }
  # 3. labels (the help channels) in the plan repo
  for l in $LABELS; do act "label '$l' in $PLAN" bash -c "gh api -X POST repos/$PLAN/labels -f name='$l' >/dev/null 2>&1 || true"; done
  # 4. workflow callers in every repo that needs them
  # Plan repo: wake, change-sync, owner-alert and the schedules. Code repos: wake and review only
  # (running the schedules in several repos would run every role several times).
  for r in "${CODES[@]}"; do
    act "open a PR in $r that installs the crew workflow callers for a code repo (wake, review; harness $HREPO@$HREF)" bash "$HERE/crew" _install-callers "$r" "$HREPO" "$HREF" "$RUNNER" "$work" "$DRY" "$PLAN" code
  done
  act "open a PR in $PLAN that installs the crew workflow callers for the plan repo (wake, change-sync, owner-alert, schedules; harness $HREPO@$HREF)" bash "$HERE/crew" _install-callers "$PLAN" "$HREPO" "$HREF" "$RUNNER" "$work" "$DRY" "$PLAN" plan
  # 5. Claude login: the token is fetched by `claude setup-token` and piped into each repo's secret. Nothing is pasted.
  allrepos=$(IFS=,; echo "$PLAN,${CODES[*]}")
  if [ "$CLAUDE_LOGIN" = 1 ]; then
    act "log in to Claude (browser) and store CLAUDE_CODE_OAUTH_TOKEN in: ${allrepos}" python3 "$HERE/lib/claude_token.py" --repos "$allrepos"
  else say "NEXT   claude login skipped: run: python3 scripts/lib/claude_token.py --repos $allrepos"; fi
  # 6. repo access for the workflows: App installation tokens (one click) instead of a personal access token
  case "$IDENT" in
    single) act "create ONE GitHub App for the crew (browser: click 'Create GitHub App', then install it) and store CREW_APP_ID / CREW_APP_KEY" \
              bash "$HERE/crew" apps create --crew "$work/plan/crew.json" --single ;;
    roles)  act "create one GitHub App per role (browser clicks) and store the keys" bash "$HERE/crew" apps create --crew "$work/plan/crew.json" ;;
    token)  say "NEXT   identity=token: set CREW_REPO_TOKEN (a fine-grained token with contents, issues and pull requests on all the repos) in: $allrepos" ;;
  esac
  [ "$RUNNER" = routines ] && say "NEXT   routines runner: create one routine per role and store each fire token as the secret named in crew.json roles.*.secret"
  say "NEXT   then run: crew activate --crew $work/plan/crew.json   (merges the install PRs, enables the schedules, runs doctor)"
  [ "$FAILED" = 0 ] || exit 1
}

# crew _install-callers <repo> <harness-repo> <ref> <runner> <workdir> <dry> <plan-repo> <plan|code>
cmd_install_callers() {
  local repo="$1" hrepo="$2" href="$3" runner="$4" work="$5" dry="$6" plan="$7" kind="${8:-plan}" d
  callers_for() { # which caller templates a repo kind gets
    local f b
    for f in "$HARNESS"/templates/callers/*.yml; do
      [ -f "$f" ] || continue; b=$(basename "$f")
      case "$kind:$b" in
        code:crew-wake.yml|code:crew-review.yml) echo "$f" ;;
        plan:crew-wake.yml|plan:crew-change-sync.yml|plan:crew-owner-alert.yml) echo "$f" ;;
        plan:crew-schedule-*) [ "$runner" = actions ] && echo "$f" ;;
      esac
    done
  }
  [ "$dry" = 1 ] && { say "         would add: $(callers_for | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"; return 0; }
  # Idempotent: an open install PR means a previous run already did this.
  [ "$(gh pr list -R "$repo" --head crew/install-workflows --state open --json number --jq length 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null &&
    { say "         install PR already open in $repo, skipping"; return 0; }
  d="$work/callers-$(echo "$repo" | tr / -)"
  gh repo clone "$repo" "$d" -- -q >/dev/null 2>&1 || return 1
  git -C "$d" checkout -q -b crew/install-workflows || return 1
  mkdir -p "$d/.github/workflows"
  for f in $(callers_for); do
    sed -e "s#<HARNESS_REPO>#$hrepo#g" -e "s#<HARNESS_REF>#$href#g" -e "s#<PLAN_REPO>#$plan#g" "$f" > "$d/.github/workflows/$(basename "$f")"
  done
  git -C "$d" add -A && git -C "$d" diff --cached --quiet && return 0
  git -C "$d" commit -q -m "Install claude-ai-crew workflow callers" && git -C "$d" push -q -u origin crew/install-workflows &&
    gh pr create -R "$repo" --head crew/install-workflows --title "Install claude-ai-crew workflow callers" \
      --body "Adds thin caller workflows for the crew harness ($hrepo@$href). Review before merging." >/dev/null
}

# crew apps create|list
cmd_apps() {
  local sub="${1:-}"; shift || true
  local cfg="${CREW_CONFIG:-./crew.json}" org=0 single=0 roles=() r
  while [ $# -gt 0 ]; do case "$1" in
    --crew) cfg="$2"; shift ;; --role) roles+=("$2"); shift ;; --org) org=1 ;; --single) single=1 ;; --plan) DRY=1 ;; *) die "unknown option: $1" ;; esac; shift; done
  [ -f "$cfg" ] || die "no crew.json at $cfg (use --crew)"
  command -v jq >/dev/null || die "jq is required"
  local project owner repos; project=$(jq -r .project "$cfg"); owner=$(jq -r .owner.login "$cfg")
  repos=$(jq -r '[.repos.plan] + .repos.code | join(",")' "$cfg")
  if [ "$single" = 1 ]; then roles=(crew)
  elif [ "${#roles[@]}" -eq 0 ]; then while IFS= read -r r; do roles+=("$r"); done < <(jq -r '.roles | keys[]' "$cfg"); fi
  case "$sub" in
    create)
      command -v python3 >/dev/null || die "python3 is required"
      local singleflag=(); [ "$single" = 1 ] && singleflag=(--single)
      local orgflag=(); [ "$org" = 1 ] && { owner=$(jq -r '.repos.plan | split("/")[0]' "$cfg"); orgflag=(--org); }
      say "crew apps: roles=${roles[*]} owner=$owner$([ "$org" = 1 ] && echo " (organization)") keys stored in: $repos"
      for r in "${roles[@]}"; do
        if [ "$DRY" = 1 ]; then say "PLAN   create GitHub App ${project}-${r} (opens your browser; you click 'Create GitHub App'), then store the key and id for $r"; continue; fi
        say "== role $r: a browser tab opens; click 'Create GitHub App' on github.com"
        python3 "$HERE/lib/app_manifest.py" --project "$project" --role "$r" --owner "$owner" ${orgflag[@]+"${orgflag[@]}"} ${singleflag[@]+"${singleflag[@]}"} --repos "$repos" || { say "FAIL   app for $r"; FAILED=1; }
      done
      say "NEXT   install each new App on: $repos (the INSTALL links above), then run: crew doctor $cfg"
      [ "$FAILED" = 0 ] || exit 1 ;;
    list)
      local rp; for rp in $(jq -r '.repos.plan, .repos.code[]' "$cfg"); do
        local sn vn; sn=$(gh secret list -R "$rp" --json name --jq '.[].name' 2>/dev/null); vn=$(gh variable list -R "$rp" --json name --jq '.[].name' 2>/dev/null)
        grep -qx "CREW_APP_KEY" <<<"$sn" && grep -qx "CREW_APP_ID" <<<"$vn" && say "OK     $rp: shared crew App key and id" || say "MISSING $rp: shared crew App (CREW_APP_KEY / CREW_APP_ID)"
        for r in "${roles[@]}"; do
          [ "$single" = 1 ] && continue
          local sfx; sfx=$(tr 'a-z-' 'A-Z_' <<<"$r")
          grep -qx "AGENT_APP_KEY_$sfx" <<<"$sn" && grep -qx "AGENT_APP_ID_$sfx" <<<"$vn" && say "OK     $rp: $r has an App key and id" || say "MISSING $rp: $r (AGENT_APP_KEY_$sfx / AGENT_APP_ID_$sfx)"
        done
      done ;;
    *) die "usage: crew apps create|list [--crew crew.json] [--role R] [--org] [--plan]" ;;
  esac
}

ok() { say "OK     $*"; }; warn() { say "WARN   $*"; W=$((W+1)); }; bad() { say "FAIL   $*"; B=$((B+1)); }
cmd_doctor() {
  W=0; B=0
  local cfg="${1:-${CREW_CONFIG:-./crew.json}}"
  for t in gh jq git; do command -v "$t" >/dev/null && ok "$t installed" || bad "$t is not installed"; done
  gh auth status >/dev/null 2>&1 && ok "gh is logged in" || bad "gh is not logged in (gh auth login)"
  [ -f "$cfg" ] || { bad "no crew.json at $cfg"; say "doctor: $B fail, $W warn"; exit 1; }
  bash "$HERE/validate-pack.sh" "$cfg" >/dev/null 2>&1 && ok "crew.json is valid" || bad "crew.json is invalid (run scripts/validate-pack.sh $cfg)"
  local plan; plan=$(jq -r '.repos.plan' "$cfg"); local repos; repos=$(jq -r '.repos.plan, .repos.code[]' "$cfg")
  local r l
  for r in $repos; do
    gh api "repos/$r" >/dev/null 2>&1 && ok "repo $r reachable" || { bad "repo $r not reachable"; continue; }
    gh api "repos/$r/contents/.github/workflows/crew-wake.yml" >/dev/null 2>&1 && ok "$r: wake caller installed" || warn "$r: crew-wake.yml not installed (merge the install PR)"
    local names; names=$(gh secret list -R "$r" --json name --jq '.[].name' 2>/dev/null)
    grep -qx CLAUDE_CODE_OAUTH_TOKEN <<<"$names" && ok "$r: Claude token set" || warn "$r: CLAUDE_CODE_OAUTH_TOKEN missing (run: crew init, or python3 scripts/lib/claude_token.py --repos $r)"
    local vars0; vars0=$(gh variable list -R "$r" --json name --jq '.[].name' 2>/dev/null)
    if grep -qx CREW_APP_KEY <<<"$names" && grep -qx CREW_APP_ID <<<"$vars0"; then ok "$r: shared crew App configured"
    elif grep -qx CREW_REPO_TOKEN <<<"$names"; then ok "$r: CREW_REPO_TOKEN set (token identity)"
    elif grep -q '^AGENT_APP_KEY_' <<<"$names"; then ok "$r: per-role Apps configured"
    else warn "$r: no repo access configured (run: crew apps create --single)"; fi
    if grep -q '^AGENT_APP_KEY_' <<<"$names"; then
      local vars role sfx; vars=$(gh variable list -R "$r" --json name --jq '.[].name' 2>/dev/null)
      for role in $(jq -r '.roles | keys[]' "$cfg"); do
        sfx=$(tr 'a-z-' 'A-Z_' <<<"$role")
        grep -qx "AGENT_APP_KEY_$sfx" <<<"$names" && grep -qx "AGENT_APP_ID_$sfx" <<<"$vars" && ok "$r: role $role has an App key and id" || warn "$r: role $role has no App key/id (crew apps create --role $role)"
      done
    else ok "$r: no per-role Apps stored (solo identity)"; fi
  done
  for l in needs-rescue needs-owner needs-research needs-work debate harness-backlog; do
    gh api "repos/$plan/labels/$l" >/dev/null 2>&1 && ok "label $l" || warn "label $l missing in $plan"
  done
  say "doctor: $B fail, $W warn"; [ "$B" = 0 ]
}

# crew activate: merge the install PRs, enable the schedules, run doctor
cmd_activate() {
  local cfg="${CREW_CONFIG:-./crew.json}" yes=0
  while [ $# -gt 0 ]; do case "$1" in --crew) cfg="$2"; shift ;; --yes) yes=1 ;; *) die "unknown option: $1" ;; esac; shift; done
  [ -f "$cfg" ] || die "no crew.json at $cfg (use --crew)"
  local plan repos r n prs=()
  plan=$(jq -r '.repos.plan' "$cfg"); repos="$plan $(jq -r '.repos.code[]' "$cfg")"
  for r in $repos; do
    n=$(gh pr list -R "$r" --head crew/install-workflows --state open --json number --jq '.[0].number // empty' 2>/dev/null)
    [ -n "$n" ] && prs+=("$r#$n")
  done
  if [ "${#prs[@]}" -gt 0 ]; then
    say "install PRs to merge: ${prs[*]}"
    if [ "$yes" != 1 ]; then read -r -p "Merge them and enable the schedules? [y/N] " a; [ "$a" = y ] || [ "$a" = Y ] || die "stopped"; fi
    for p in "${prs[@]}"; do
      r=${p%#*}; n=${p#*#}
      local st; st=$(gh pr view "$n" -R "$r" --json mergeStateStatus --jq .mergeStateStatus 2>/dev/null)
      if [ "$st" = CLEAN ] || [ "$st" = UNSTABLE ] || [ "$st" = HAS_HOOKS ]; then act "merge $r#$n" gh pr merge "$n" -R "$r" --merge
      else say "WARN   $r#$n is $st: not merged (fix it, then run crew activate again)"; fi
    done
  else say "no open install PRs (already merged?)"; fi
  # the schedules were disabled by `crew init` runs that predate secrets; enable them once the Claude token exists
  local names; names=$(gh secret list -R "$plan" --json name --jq '.[].name' 2>/dev/null)
  if grep -qx CLAUDE_CODE_OAUTH_TOKEN <<<"$names"; then
    for w in crew-schedule-worker crew-schedule-lead crew-schedule-pm; do
      gh api "repos/$plan/actions/workflows/$w.yml" >/dev/null 2>&1 && act "enable $w in $plan" gh workflow enable "$w.yml" -R "$plan"
    done
  else say "WARN   no Claude token in $plan: schedules left as they are"; fi
  cmd_doctor "$cfg"
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  apps) shift; cmd_apps "$@" ;;
  activate) shift; cmd_activate "$@" ;;
  _install-callers) shift; cmd_install_callers "$@" ;;
  ""|-h|--help|help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: crew help)" ;;
esac
